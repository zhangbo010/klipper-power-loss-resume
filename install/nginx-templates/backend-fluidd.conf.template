# PLR 通用：Fluidd 独立站点（由 install-nginx-dual-ui.sh 生成）
# Moonraker: 127.0.0.1:__MOONRAKER_PORT__ ；摄像头默认 8080–8083（与 Mainsail 后端端口无关）

server {
    listen __FLUIDD_BACKEND_PORT__;

    access_log /var/log/nginx/plr-fluidd-access.log;
    error_log /var/log/nginx/plr-fluidd-error.log;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 4;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml;

    root __FLUIDD_ROOT__;
    index index.html;
    server_name _;

    client_max_body_size 0;
    proxy_request_buffering off;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location /websocket {
        proxy_pass http://127.0.0.1:__MOONRAKER_PORT__/websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection Upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
    }

    location ~ ^/(printer|api|access|machine|server)/ {
        proxy_pass http://127.0.0.1:__MOONRAKER_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Scheme $scheme;
        proxy_read_timeout 600;
    }

    location /webcam/ {
        postpone_output 0;
        proxy_buffering off;
        proxy_ignore_headers X-Accel-Buffering;
        access_log /dev/null;
        error_log /dev/null;
        proxy_pass http://127.0.0.1:8080/;
    }

    location /webcam2/ {
        postpone_output 0;
        proxy_buffering off;
        proxy_ignore_headers X-Accel-Buffering;
        access_log /dev/null;
        error_log /dev/null;
        proxy_pass http://127.0.0.1:8081/;
    }

    location /webcam3/ {
        postpone_output 0;
        proxy_buffering off;
        proxy_ignore_headers X-Accel-Buffering;
        access_log /dev/null;
        error_log /dev/null;
        proxy_pass http://127.0.0.1:8082/;
    }

    location /webcam4/ {
        postpone_output 0;
        proxy_buffering off;
        proxy_ignore_headers X-Accel-Buffering;
        access_log /dev/null;
        error_log /dev/null;
        proxy_pass http://127.0.0.1:8083/;
    }
}
